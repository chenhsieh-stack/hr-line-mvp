# 複製為 .env；run.py 會讀取，已存在的環境變數優先。
HOST=127.0.0.1
PORT=8000
ADMIN_USERNAME=hr
ADMIN_PASSWORD=HR-demo-2026!
# 正式設定請改用足夠長的隨機值；空白會建立本機 instance/local-secret。
SECRET_KEY=
# 可選：使用 Werkzeug 產生的密碼雜湊，優先於 ADMIN_PASSWORD。
ADMIN_PASSWORD_HASH=
# 空白時完全不載入 LINE SDK，本機測試不需 LINE 帳號。
LINE_LIFF_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 僅允許 https，設定後可在 LINE 關鍵字回覆提供表單連結。
PUBLIC_APP_URL=
# SQLite 檔案預設為專案的 instance/hr.sqlite3。
DATABASE_PATH=
# 本機為 false；放在 HTTPS 反向代理後才能改為 true。
COOKIE_SECURE=false
